#!/usr/bin/env bash
# Run the bridge with the Eufy credentials from ~/.config/eufy-bridge/env (0600):
#   EUFY_USER=...   EUFY_PASS=...   (optional: EUFY_DEVICE_SN, LIVE_SECONDS, ...)
set -euo pipefail
env_file="${EUFY_BRIDGE_ENV:-$HOME/.config/eufy-bridge/env}"
set -a; . "$env_file"; set +a
cd "$(dirname "$0")/.."
exec node bridge.js
